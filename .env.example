# PostgreSQL connection
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/epc_workforce?schema=public"

# Auth.js — generate with: npx auth secret   (or any 32+ random chars)
AUTH_SECRET="replace-with-a-long-random-string"

# Company timezone used for "today", daily/weekly/monthly attendance
APP_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_COMPANY_NAME="ABC"
NEXT_PUBLIC_COMPANY_BRANCHES="Aluva (HQ)"

# Maps (Leaflet). Defaults to OpenStreetMap tiles; for production traffic use a
# commercial tile provider, e.g. https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=...
NEXT_PUBLIC_MAP_TILE_URL=""
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=""
NEXT_PUBLIC_MAP_DEFAULT_CENTER="10.1076,76.3516"

# Show demo accounts on the login page (development only)
NEXT_PUBLIC_SHOW_DEMO_LOGINS="true"

# File storage — leave S3_BUCKET empty to store files in ./storage
STORAGE_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com or http://localhost:9000 for MinIO
S3_FORCE_PATH_STYLE="false" # "true" for MinIO
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Workflow reminders: "off" disables the in-process daily job (use /api/cron/reminders instead)
REMINDERS_SCHEDULER=""
# Bearer token for GET /api/cron/reminders from an external scheduler
CRON_SECRET=""
